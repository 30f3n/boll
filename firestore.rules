rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/mudaribi_matches/{docId} {
      // السماح للاعبين بقراءة التشكيلة وتفاصيل المباراة فقط
      allow read: if true;

      // السماح بالكتابة لحساب الإدارة الموثّق عبر Firebase Auth فقط
      // استبدل YOUR_ADMIN_EMAIL ببريدك الإلكتروني الخاص بالإدارة
      allow write: if request.auth != null
                   && request.auth.token.email == "YOUR_ADMIN_EMAIL";
    }
  }
}
