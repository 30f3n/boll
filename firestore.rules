rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/mudaribi_matches/{docId} {
      // السماح للاعبين بقراءة التشكيلة وتفاصيل المباراة فقط
      allow read: if true;

      // السماح بالتعديل والكتابة لحساب الإدارة المحدّد بالـ UID فقط
      allow write: if request.auth != null
                   && request.auth.uid == "iMhghaknGOQqtuuPuGpwX5ZsNv43";
    }
  }
}
